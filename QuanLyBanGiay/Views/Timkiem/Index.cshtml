@model IEnumerable<QuanLyBanGiay.Models.Sanpham>

<div class="container mt-4">
    <h3>Kết quả tìm kiếm cho: "@ViewBag.Keyword"</h3>
    <hr />

    @if (!Model.Any())
    {
        <p class="text-muted">Không tìm thấy sản phẩm nào phù hợp.</p>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div style="height:150px; display:flex; justify-content:center; align-items:center; margin-top:15px;">
                            <img src="@(Url.Content("~/images/Sanpham/" + item.Hinhdaidien))"
                                 alt="@item.Tensp"
                                 style="max-width:100%; max-height:100%; object-fit:contain; border-radius:8px;" />
                        </div>

                        <div class="card-body text-center">
                            <h6>@item.Tensp</h6>
                            <p class="fw-bold text-danger">@String.Format("{0:N0} ₫", item.Gia)</p>
                            <a href="#" class="btn btn-outline-dark btn-sm">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
