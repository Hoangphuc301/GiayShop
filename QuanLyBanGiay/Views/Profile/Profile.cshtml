@model QuanLyBanGiay.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container mt-4">
    <h3 class="mb-4">Thông tin cá nhân</h3>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">@ViewBag.Message</div>
    }

    <form asp-action="Profile" method="post" class="card p-4 shadow-sm">
        <input type="hidden" asp-for="Makh" />

        <div class="mb-3">
            <label class="form-label">Họ tên</label>
            <input asp-for="Tenkh" class="form-control" />
            <span asp-validation-for="Tenkh" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Số điện thoại</label>
            <input asp-for="Sdt" class="form-control" maxlength="11"
                   pattern="[0-9]*" inputmode="numeric"
                   placeholder="Nhập số điện thoại..." />
            <span asp-validation-for="Sdt" class="text-danger"></span>
        </div>

        <!-- Tỉnh / Thành phố -->
        <div class="mb-3">
            <label class="form-label">Tỉnh / Thành phố</label>
            <select id="tinhthanh" class="form-select" asp-for="TinhThanh">
                <option value="">-- Chọn Tỉnh / Thành phố --</option>
            </select>
        </div>

        <!-- Quận / Huyện -->
        <div class="mb-3">
            <label class="form-label">Quận / Huyện</label>
            <select id="quanhuyen" class="form-select" asp-for="QuanHuyen">
                <option value="">-- Chọn Quận / Huyện --</option>
            </select>
        </div>

        <!-- Địa chỉ cụ thể -->
        <div class="mb-3">
            <label class="form-label">Địa chỉ cụ thể</label>
            <textarea asp-for="DiachiCuThe" class="form-control" rows="2"
                      placeholder="VD: 123 Lê Lợi, phường Bến Thành"></textarea>
        </div>

        <!-- Hiển thị địa chỉ đầy đủ -->
        <div class="mb-3">
            <label class="form-label">Địa chỉ đầy đủ</label>
            <input type="text" id="fullAddress" class="form-control" readonly
                   value="@Model.Diachi" />
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Quay về trang chủ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const provinceSelect = document.getElementById("tinhthanh");
            const districtSelect = document.getElementById("quanhuyen");
            const addressDetail = document.querySelector("[name='DiachiCuThe']");
            const fullAddress = document.getElementById("fullAddress");

            const currentProvince = '@Model.TinhThanh';
            const currentDistrict = '@Model.QuanHuyen'; 

            // Load API tỉnh/huyện
            fetch("https://provinces.open-api.vn/api/v1/?depth=2") //Gọi API
                .then(res => res.json())
                .then(data => { //Xử lý dữ liệu JSON trả về từ API
                    data.forEach(province => {
                        const opt = document.createElement("option");
                        opt.value = province.name;
                        opt.textContent = province.name;
                        if (province.name === currentProvince) opt.selected = true;
                        provinceSelect.appendChild(opt); //Lưu vào cuối
                    });

                    const selectedProvince = data.find(p => p.name === currentProvince); //Tìm tỉnh được chọn hiện tại
                    if (selectedProvince) { //Nếu tìm thấy thì hiển thị danh sách QH
                        selectedProvince.districts.forEach(d => {
                            const opt = document.createElement("option");
                            opt.value = d.name;
                            opt.textContent = d.name;
                            if (d.name === currentDistrict) opt.selected = true;
                            districtSelect.appendChild(opt);
                        });
                    }

                    provinceSelect.addEventListener("change", () => {  //Khi thay đổi 
                        districtSelect.innerHTML = '<option value="">-- Chọn Quận / Huyện --</option>'; //Xóa danh sách QH hiện tại
                        const selected = data.find(p => p.name === provinceSelect.value); //Tìm tỉnh được chọn
                        if (selected) {
                            selected.districts.forEach(d => { //Thêm QH vào danh sách
                                const opt = document.createElement("option");
                                opt.value = d.name;
                                opt.textContent = d.name;
                                districtSelect.appendChild(opt);
                            });
                        }
                        updateFullAddress(); //Cập nhật địa chỉ đầy đủ
                    });
                });

            // Tự động cập nhật địa chỉ đầy đủ khi nhập/sửa
            function updateFullAddress() {
                const full = [addressDetail.value, districtSelect.value, provinceSelect.value] //Chứa địa chỉ, QH, TP
                    .filter(x => x && x.trim() !== "") //Lọc bỏ giá trị rỗng
                    .join(", "); //Nối chuỗi với dấu phẩy
                fullAddress.value = full; 
            }

            addressDetail.addEventListener("input", updateFullAddress); // Khi nhập địa chỉ cụ thể
            districtSelect.addEventListener("change", updateFullAddress); // khi thay đổi QH
        });
    </script>
}
