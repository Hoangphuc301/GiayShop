@model List<QuanLyBanGiay.Models.Donhang>

<h2 class="mt-4 text-primary">Lịch sử đơn hàng của bạn</h2>

<div class="card shadow-sm mt-3">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Tác vụ</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            Bạn chưa có đơn hàng nào.
                        </td>
                    </tr>
                }
                @foreach (var dh in Model)
                {
                    <tr>
                        <td>@dh.Ngaydat?.ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap">@dh.Tongtiencuoi?.ToString("N0") VNĐ</td>
                        <td>
                            @{
                                string badgeClass = dh.Trangthai switch
                                {
                                    "Chờ xác nhận" => "bg-warning text-dark",
                                    "Đang giao" => "bg-primary",
                                    "Đã giao" => "bg-success",
                                    "Đã hủy" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">
                                @dh.Trangthai
                            </span>
                        </td>
                        <td class="text-center text-nowrap">
                            <a asp-controller="Profile" asp-action="ChiTietDH" asp-route-id="@dh.Madh" class="btn btn-sm btn-info text-white" title="Xem chi tiết đơn hàng">
                                Xem chi tiết
                            </a>
                            @if (dh.Trangthai == "CHỜ XÁC NHẬN")
                            {
                                <a asp-controller="Profile" asp-action="Huy" asp-route-id="@dh.Madh" class="btn btn-sm btn-danger" title="Hủy đơn hàng này" onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?');">
                                    Hủy
                                </a>
                            }
                            @if (dh.Trangthai == "ĐÃ GIAO" || dh.Trangthai == "ĐÃ HỦY")
                            {
                                <a asp-controller="Profile" asp-action="DatLai" asp-route-id="@dh.Madh" class="btn btn-sm btn-success" title="Đặt lại đơn hàng này">
                                    Đặt lại
                                </a>
                            }
                            @if(dh.Trangthai == "CHỜ THANH TOÁN")
                            {
                                <a asp-controller="Profile" asp-action="Thanhtoan" asp-route-id="@dh.Madh" class="btn btn-sm btn-success" title="Thanh toán đơn hàng này">
                                    Thanh Toán
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>