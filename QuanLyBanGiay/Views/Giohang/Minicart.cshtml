@model List<QuanLyBanGiay.Models.CartItem>
@using System.Globalization

<div id="miniCartContainer" class="mini-cart p-3 shadow rounded bg-white" style="width: 320px;">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <span class="fw-bold fs-5">🛒 Giỏ hàng</span>
        <a href="javascript:;" onclick="document.getElementById('miniCartContainer').style.display='none'"
           style="text-decoration:none; font-size:24px; color:#333;">×</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <p class="text-center text-muted my-4">Giỏ hàng trống</p>
    }
    else
    {
        var subtotal = Model.Sum(i => i.Sl * i.Dongia);

        <ul class="list-unstyled">
            @foreach (var item in Model)
            {
                var total = item.Sl * item.Dongia;
                <li class="d-flex mb-3 align-items-center border-bottom pb-2">
                    <img src="@(Url.Content("~/images/Sanpham/" + item.Hinhanh))"
                         alt="@item.Tensp"
                         class="img-fluid rounded border me-2"
                         style="height:55px;width:55px; object-fit:contain;" />

                    <div class="flex-grow-1">
                        <div class="fw-semibold text-truncate" style="font-size:14px;">@item.Tensp</div>
                        <div class="text-muted" style="font-size:12px;">
                            Màu: @item.Mau | Size: @item.Size
                        </div>
                        <div style="font-size:13px;">
                            @item.Sl x @String.Format("{0:0,0} đ", item.Dongia)
                        </div>
                    </div>
                </li>
            }
        </ul>

        <div class="d-flex justify-content-between mt-3">
            <strong>Tạm tính:</strong>
            <span class="fw-semibold">@String.Format("{0:0,0} đ", subtotal)</span>
        </div>

        <a href="@Url.Action("Index", "Giohang")" class="btn btn-dark w-100 mt-3">Xem giỏ hàng</a>
    }
</div>
