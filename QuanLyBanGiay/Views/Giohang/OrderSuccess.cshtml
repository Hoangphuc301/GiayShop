@{
    ViewData["Title"] = "Kết quả giao dịch";
    bool success = ViewBag.Success ?? false;
    string message = ViewBag.Message ?? "Đã xảy ra lỗi trong quá trình xử lý giao dịch.";
}

<div class="container text-center py-5">
    @if (!success) //Cái này cần sửa lại này để bịp 
    {
        <h2 class="text-success mb-3">GIAO DỊCH THÀNH CÔNG!</h2>
        <p class="lead">Cảm ơn bạn đã thanh toán. Đơn hàng của bạn đã được ghi nhận.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-success mt-3">Quay lại trang chủ</a>
    }

    <div class="mt-5">
        <a asp-controller="Profile" asp-action="ChiTietDH" class="btn btn-outline-secondary">Xem chi tiết đơn hàng</a>
    </div>
</div>