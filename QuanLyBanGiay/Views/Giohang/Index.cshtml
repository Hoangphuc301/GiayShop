@model QuanLyBanGiay.Models.ViewModels.Checkout
@using System.Globalization

<link rel="stylesheet" href="~/css/Soluong.css" />

<h3 style="color:#ee4d2d">Giỏ hàng của bạn</h3>

@if (!Model.CartItems.Any())
{
    <p>Giỏ hàng trống</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Màu</th>
                <th>Size</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Tổng tiền</th>
                <th>Tác vụ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.CartItems)
            {
                decimal total = item.Sl * item.Dongia;
                <tr>
                    <td>
                        <img src="@(Url.Content("~/images/Sanpham/" + item.Hinhanh))"
                             alt="@item.Tensp"
                             class="img-fluid rounded border me-2"
                             style="height:50px;width:50px; object-fit:contain;" />
                        @item.Tensp
                    </td>
                    <td>@item.Mau</td>
                    <td>@item.Size</td>
                    <td>@String.Format("{0:0,0} đ", item.Dongia)</td>
                    <td>
                        <div class="quantity-box">
                            <button type="button" class="btn-qty" onclick="doiGiaTri(@item.Mactsp, -1)">−</button>
                            <input type="text" id="qty_@item.Mactsp" value="@item.Sl" min="1" class="qty-input"
                                   onchange="capNhatSoLuong(@item.Mactsp)" />
                            <button type="button" class="btn-qty" onclick="doiGiaTri(@item.Mactsp, 1)">+</button>
                        </div>
                    </td>
                    <td style="color:#ee4d2d">@String.Format("{0:0,0} đ", total)</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="mactsp" value="@item.Mactsp" />
                            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

     var subtotal = Model.CartItems.Sum(i => i.Sl * i.Dongia);

    <div class="float-end mb-4">
        <h5 style="color:#ee4d2d">Tổng cộng: <span id="subtotal">@String.Format("{0:0,0} đ", subtotal)</span></h5>
    </div>

    <br />
    <hr class="my-4" />
    
    <div class="d-flex justify-content-end">
        <a asp-action="Checkout" class="btn btn-orange">Mua hàng</a>
    </div>

    <style>
        .btn-orange {
            background-color: #ff5722;
            color: #fff;
            border: none;
            padding: 0.5rem 1.25rem;
            font-weight: 500;
            border-radius: 4px;
            transition: background-color 0.3s;
        }

        .btn-orange:hover {
            background-color: #e64a19;
            color: #fff;
        }
    </style>
}

@section Scripts {
    <script>
        function doiGiaTri(mactsp, delta) {
            const input = document.getElementById('qty_' + mactsp);
            let value = parseInt(input.value) || 1;
            value += delta;
            if (value < 1) value = 1;
            input.value = value;
            capNhatSoLuong(mactsp);
        }

        function capNhatSoLuong(mactsp) {
            const input = document.getElementById('qty_' + mactsp);
            const qty = parseInt(input.value) || 1;

            const dongiaElem = input.closest('tr').querySelector('td:nth-child(4)');
            const dongia = parseInt(dongiaElem.textContent.replace(/\D/g, '')) || 0;

            const tongTienElem = input.closest('tr').querySelector('td:nth-child(6)');
            tongTienElem.textContent = formatVND(qty * dongia);

            updateSubtotal();
        }

        function updateSubtotal() {
            let subtotal = 0;
            document.querySelectorAll('tbody tr').forEach(tr => {
                const tongTienElem = tr.querySelector('td:nth-child(6)');
                const value = parseInt(tongTienElem.textContent.replace(/\D/g, '')) || 0;
                subtotal += value;
            });
            document.querySelector('#subtotal').textContent = formatVND(subtotal);
        }

        function formatVND(number) {
            return number.toLocaleString('vi-VN') + ' đ';
        }

        document.addEventListener('DOMContentLoaded', updateSubtotal);
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}