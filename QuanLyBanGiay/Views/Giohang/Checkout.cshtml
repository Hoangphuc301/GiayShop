@model QuanLyBanGiay.Models.ViewModels.Checkout
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Globalization

@{
    var culture = new CultureInfo("vi-VN");
    var subtotal = Model.CartItems.Sum(i => i.Sl * i.Dongia);
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Lỗi Đặt Hàng</h4>
        <ul>
            @foreach (var modelState in ViewData.ModelState.Values)
            {
                @foreach (var error in modelState.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            }
        </ul>
    </div>
}

@Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

@if (!Model.CartItems.Any())
{
    <p>Giỏ hàng trống. Vui lòng quay lại <a asp-action="Index">Giỏ hàng</a>.</p>
}
else
{
    <div class="row">

        <div class="col-lg-7">

            <h4 style="color:#ee4d2d">Thông tin người nhận</h4>
            <form asp-action="Checkout" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Makh" />
                <input type="hidden" asp-for="TotalAmount" id="TotalAmount" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Họ tên</label>
                        <input asp-for="Tenkh" class="form-control" placeholder="Nhập họ tên..." />
                        <span asp-validation-for="Tenkh" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Số điện thoại người nhận</label>
                        <input asp-for="Sdt" class="form-control" placeholder="Nhập số điện thoại..." />
                        <span asp-validation-for="Sdt" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Địa chỉ người nhận</label>
                        <input asp-for="Diachi" class="form-control" placeholder="Nhập địa chỉ..." />
                        <span asp-validation-for="Diachi" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Lời nhắn (Ghi chú)</label>
                        <input asp-for="Email" class="form-control" placeholder="Lưu ý cho người bán..." />
                    </div>
                </div>

                <hr class="my-4" />

                <div class="mb-4">
                    <label class="form-label">Chọn Voucher</label>
                    <select id="voucherSelect" name="Mavoucher" class="form-select">
                        @foreach (var v in ViewBag.Vouchers as List<SelectListItem>)
                        {
                            <option value="@v.Value" data-percent="@(v.Group?.Name ?? "0")">@v.Text</option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <h5 style="color:#ee4d2d">Chọn phương thức thanh toán</h5>
                    <select asp-for="Mapttt" asp-items="Model.PaymentMethods" class="form-select form-select-lg">
                    </select>
                    <span asp-validation-for="Mapttt" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a href="@Url.Action("Index", "Giohang")" class="btn btn-outline-secondary me-2">
                        Quay lại giỏ hàng
                    </a>
                    <button type="submit" class="btn btn-orange">Đặt hàng</button>
                </div>

                <style>
                    .btn-orange {
                        background-color: #ff5722;
                        color: #fff;
                        border: none;
                        padding: 0.5rem 1.25rem;
                        font-weight: 500;
                        border-radius: 4px;
                        transition: background-color 0.3s;
                    }

                        .btn-orange:hover {
                            background-color: #e64a19;
                            color: #fff;
                        }
                </style>

            </form>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header" style="background-color:#ee4d2d; color:white;">
                    <i class="fas fa-receipt"></i> Chi tiết đơn hàng
                </div>
                <div class="card-body">

                    <h5 class="mb-3" style="color:#ee4d2d">Sản phẩm đã chọn</h5>
                    <table class="table table-bordered table-sm mb-4">
                        <thead>
                            <tr class="table-secondary">
                                <th>STT</th>
                                <th>Tên sản phẩm</th>
                                <th>Size</th>
                                <th>SL</th>
                                <th>Đơn giá</th>
                                <th class="text-end">Tổng tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 1;
                                foreach (var item in Model.CartItems)
                                {
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.Tensp (@item.Mau)</td>
                                        <td>@item.Size</td>
                                        <td>@item.Sl</td>
                                        <td>@String.Format(culture, "{0:N0} đ", item.Dongia)</td>
                                        <td class="text-end">@String.Format(culture, "{0:N0} đ", item.Sl * item.Dongia)</td>
                                    </tr>
                                    count++;
                                }
                            }
                        </tbody>
                    </table>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính (Tổng đơn hàng)</span>
                        <span class="fw-bold">@String.Format(culture, "{0:N0} đ", subtotal)</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 text-danger border-bottom pb-2">
                        <span>Voucher giảm giá</span>
                        <span id="discount-amount" class="fw-bold">- 0 đ</span>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <h4 class="mb-0" style="color:#ee4d2d">TỔNG THANH TOÁN:</h4>
                        <h4 class="mb-0" style="color:#ee4d2d"><span id="final-total">@String.Format(culture, "{0:N0} đ", subtotal)</span></h4>
                    </div>
                </div>
            </div>
        </div>

    </div>
}

@section Scripts {
    @{
        var subtotal = Model.CartItems.Sum(i => i.Sl * i.Dongia);
    }
    <script>

        const voucherSelect = document.getElementById("voucherSelect");
        const finalTotalDisplay = document.getElementById("final-total");
        const discountAmountDisplay = document.getElementById("discount-amount");
        const hiddenTotalInput = document.getElementById("TotalAmount");

        let originalTotal = @subtotal;

        function formatCurrency(number) {
            return Math.round(number).toLocaleString("vi-VN") + " đ";
        }

        function updateTotal() {
            let selectedOption = voucherSelect.options[voucherSelect.selectedIndex];
            let percent = parseFloat(selectedOption.getAttribute("data-percent")) || 0;

            let discount = originalTotal * (percent / 100);
            let newTotal = originalTotal - discount;

            discountAmountDisplay.innerHTML = "- " + formatCurrency(discount);
            finalTotalDisplay.innerHTML = formatCurrency(newTotal);

            hiddenTotalInput.value = Math.round(newTotal);
        }

        updateTotal();
        voucherSelect.addEventListener("change", updateTotal);

    </script>
}
