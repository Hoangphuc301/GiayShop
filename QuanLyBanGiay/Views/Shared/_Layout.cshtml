@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var title = ViewData["Title"] ?? "Styleofme.vn | Giày Chính Hãng";
    var userEmail = Context.Session.GetString("UserEmail"); // Lấy từ Session
    var userRole = Context.Session.GetString("UserRole");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Font Awesome & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Layout.css" />
</head>
<body>
    <!-- Thanh thông báo -->
    <div class="top-bar">
        FREESHIP toàn quốc cho đơn hàng từ 10.000.000₫
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light sticky-top bg-white shadow-sm">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.jpg" alt="StyleOfMe Logo" style="height:70px; width:auto; margin-right:10px;">
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menu -->
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Giày Nam</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Giày Nữ</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Thương hiệu</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Khuyến mãi</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="aboutDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">Chính sách hỗ trợ</a>
                        <ul class="dropdown-menu" aria-labelledby="aboutDropdown">
                            <li><a class="dropdown-item" asp-controller="Chinhsach" asp-action="Uudai">Chính sách ưu đãi</a></li>
                            <li><a class="dropdown-item" asp-controller="Chinhsach" asp-action="Vanchuyen">Chính sách vận chuyển</a></li>
                            <li><a class="dropdown-item" asp-controller="Chinhsach" asp-action="Doitra">Chính sách đổi trả</a></li>
                            <li><a class="dropdown-item" asp-controller="Chinhsach" asp-action="Baohanh">Chính sách bảo hành</a></li>
                        </ul>
                    </li>
                </ul>
                <div class="header-icons d-flex align-items-center gap-3">

                    <!-- Ô tìm kiếm -->
                    <form method="get" asp-controller="Timkiem" asp-action="Index" class="d-flex align-items-center">
                        <input type="text" name="q" placeholder="Tìm kiếm giày..." class="form-control me-2" />
                        <button type="submit" class="btn btn-outline-dark"><i class="fa fa-search"></i></button>
                    </form>

                    <!-- Kiểm tra đăng nhập -->
                    @if (string.IsNullOrEmpty(userEmail))
                    {
                        <!-- Chưa đăng nhập -->
                        <a asp-controller="Account" asp-action="Login" class="text-dark d-flex align-items-center">
                            <i class="fa fa-user fa-lg me-1"></i>
                            <span>Đăng nhập</span>
                        </a>
                    }
                    else
                    {
                        <!-- Đã đăng nhập -->
                        <div class="dropdown">
                            <a class="text-dark d-flex align-items-center dropdown-toggle" href="#" id="userMenu"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa fa-user fa-lg me-1"></i>
                                <span>@userEmail</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Profile">Thông tin cá nhân</a></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                            </ul>
                        </div>
                    }

                    <!-- Icon giỏ hàng -->
                    <a asp-controller="Cart" asp-action="Index" class="text-dark position-relative d-flex align-items-center">
                        <i class="fa fa-shopping-cart fa-lg"></i>
                        <span class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill">2</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Nội dung chính -->
    <div class="container mt-4 mb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5>Về Styleofme.vn</h5>
                    <p>Styleofme.vn là hệ thống bán giày chính hãng, phân phối các thương hiệu nổi tiếng như Nike, Adidas, Puma, New Balance...</p>
                </div>
                <div class="col-md-4">
                    <h5>Chính sách</h5>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Chinhsach" asp-action="Doitra">Chính sách đổi trả</a></li>
                        <li><a asp-controller="Chinhsach" asp-action="Baohanh">Chính sách bảo hành</a></li>
                        <li><a asp-controller="Chinhsach" asp-action="Vanchuyen">Chính sách vận chuyển</a></li>
                        <li><a asp-controller="Chinhsach" asp-action="Baomat">Chính sách bảo mật</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Liên hệ</h5>
                    <p>
                        <i class="fa fa-comment-dots me-2"></i>
                        <a href="https://forms.gle/FaAcQ1BaRFnYg7HH7" target="_blank" rel="noopener noreferrer">Góp ý và khiếu nại
                        </a>
                    </p>
                    <p><i class="fa fa-map-marker-alt me-2"></i>Hồ Chí Minh, Việt Nam</p>
                    <p><i class="fa fa-phone me-2"></i>Hotline: 0909 123 456</p>
                    <p><i class="fa fa-envelope me-2"></i>support@styleofme.vn</p>
                </div>
            </div>

            <div class="footer-bottom">
                &copy; 2025 - Styleofme.vn | Thiết kế bởi <strong>Nhóm SOFM</strong>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
