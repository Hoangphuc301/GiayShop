@model QuanLyBanGiay.Models.Sanpham
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var dsMau = Model.ChitietSanphams.Select(c => c.MamauNavigation).Distinct().ToList();
    var dsSize = Model.ChitietSanphams.Select(c => c.MasizeNavigation).Distinct().ToList();
}

<!-- Link CSS riêng -->
<link rel="stylesheet" href="~/css/chitiet.css" />

<div class="container mt-5 mb-5">
    <div class="row align-items-start">
        <!-- Cột trái: hình sản phẩm -->
        <div class="col-md-6 text-center">
            <img src="@(Url.Content("~/images/Sanpham/" + Model.Hinhdaidien))"
                 alt="@Model.Tensp"
                 class="img-fluid rounded shadow-sm border"
                 style="max-height: 450px; object-fit: contain;" />
        </div>

        <!-- Cột phải: thông tin chi tiết -->
        <div class="col-md-6 ps-4">
            <h3 class="fw-bold mb-2">@Model.Tensp</h3>
            <h4 class="text-danger fw-semibold mb-3">@String.Format("{0:0,0} đ", Model.Gia)</h4>

            <div class="mb-3">
                <span class="text-muted">Thương hiệu:</span> @Model.MathNavigation.Tenth <br />
                <span class="text-muted">Danh mục:</span> @Model.MadmNavigation.Tendm
            </div>

            <form method="post" asp-controller="Giohang" asp-action="ThemVaoGio">
                <input type="hidden" name="MASP" value="@Model.Masp" />

                <!-- Màu sắc -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Màu:</label>
                    <div class="color-options mt-2">
                        @foreach (var mau in dsMau)
                        {
                            <input type="radio" name="MAMAU" value="@mau.Mamau" id="mau_@mau.Mamau" class="color-input" required />
                            <label for="mau_@mau.Mamau" class="color-circle"
                                   style="background-color:@Hienthimau(mau.Tenmau);"
                                   title="@mau.Tenmau">
                            </label>
                        }
                    </div>
                </div>

                <!-- Kích thước -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Kích thước:</label>
                    <div class="size-options mt-2">
                        @foreach (var size in dsSize)
                        {
                            <input type="radio" name="MASIZE" value="@size.Masize" id="size_@size.Masize" class="size-input" required />
                            <label for="size_@size.Masize" class="size-box">@size.Tensize</label>
                        }
                    </div>
                </div>
 

                <!-- Số lượng -->
                <div class="mb-4">
                    <label class="form-label fw-semibold me-3 mb-2">Số lượng:</label>
                    <div class="quantity-box">
                        <button type="button" class="btn-qty" onclick="doiGiaTri(-1)">−</button>
                        <input type="number" name="SL" id="quantityInput" value="1" min="1" class="qty-input" />
                        <button type="button" class="btn-qty" onclick="doiGiaTri(1)">+</button>
                    </div>
                </div>

                <!-- Nút -->
                <div class="d-flex gap-3 mt-4">
                    <button type="button" class="btn btn-danger px-4 py-2">Mua ngay</button>
                    <button type="submit" class="btn btn-outline-dark px-4 py-2">
                        <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Chi tiết sản phẩm -->
    <div class="row mt-5">
        <div class="col-12">
            <h5 class="fw-bold border-bottom pb-2">CHI TIẾT SẢN PHẨM</h5>
            <div class="product-detail mt-3">
                @Model.Mota
            </div>
        </div>
    </div>
</div>

@functions {
    string Hienthimau(string tenMau)
    {
        switch (tenMau.ToLower())
        {
            case "đen": return "#000000";
            case "trắng": return "#FFFFFF";
            case "xám": return "#808080";
            case "đỏ": return "#FF0000";
            case "xanh dương": return "#0000FF";
            case "xanh lá": return "#008000";
            case "vàng": return "#FFFF00";
            case "nâu": return "#A52A2A";
            case "cam": return "#FFA500";
            case "tím": return "#800080";
            case "hồng": return "#FFC0CB";
            case "be": return "#F5F5DC";
            case "nâu đất": return "#8B4513";
            case "tan": return "#D2B48C";
            case "caramel": return "#A66A2C";
            case "coffee": return "#4B3621";
            case "chestnut": return "#954535";
            case "burgundy": return "#800020";
            case "oxblood": return "#4A0000";
            case "khaki": return "#C3B091";
            case "olive": return "#556B2F";
            case "xanh olive": return "#6B8E23";
            case "xanh navy": return "#000080";
            case "charcoal": return "#36454F";
            case "than": return "#2F4F4F";
            case "cement": return "#B2BEB5";
            case "cream": return "#FFFDD0";
            case "ivory": return "#FFFFF0";
            case "xanh pastel": return "#AEC6CF";
            case "xanh ngọc": return "#40E0D0";
            case "xanh mint": return "#98FF98";
            case "xanh da trời": return "#87CEEB";
            case "xanh lam": return "#4682B4";
            case "xanh cobalt": return "#0047AB";
            case "xanh xám": return "#708090";
            case "xanh neon": return "#39FF14";
            case "hồng pastel": return "#FFD1DC";
            case "blush pink": return "#FFB6C1";
            case "hồng đậm": return "#FF69B4";
            case "tím lavender": return "#E6E6FA";
            case "tím violet": return "#9400D3";
            case "vàng đồng": return "#B87333";
            case "vàng gold": return "#FFD700";
            case "bạc": return "#C0C0C0";
            case "metallic bạc": return "#C0C0C0";
            case "metallic vàng": return "#D4AF37";
            case "xanh ngọc lam": return "#48D1CC";
            case "đồng": return "#CD7F32";
            case "rose gold": return "#B76E79";
            case "gunmetal": return "#2A3439";
            case "metallic": return "#B0C4DE";
            case "smoke": return "#738678";
            case "sand": return "#C2B280";
            case "off white": return "#FAF9F6";
            case "indigo": return "#4B0082";
            case "xanh chàm": return "#4B0082";

            default: return "transparent";
        }
    }
}
 @section Scripts {
    <script>
        function doiGiaTri(so) {
            const input = document.getElementById('quantityInput');
            let value = parseInt(input.value) || 1;
            value += so;
            if (value < 1) value = 1;
            input.value = value;
        }
    </script>
}