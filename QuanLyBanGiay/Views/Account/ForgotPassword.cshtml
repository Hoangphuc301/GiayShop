@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container mt-5" style="max-width: 500px;">
    <h2 class="text-center mb-4">Quên mật khẩu</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">@ViewBag.Error</div>
    }
    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success text-center">@ViewBag.Success</div>
    }

    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
        <div class="mb-3">
            <label for="Email" class="form-label">Email</label>
            <input type="email" class="form-control" id="Email" name="Email"
                   placeholder="Nhập email đã đăng ký" value="@ViewBag.EmailValue" required />
        </div>

        @if (ViewBag.ShowOtpInput == true)
        {
            <div class="mb-3">
                <label for="Otp" class="form-label">Nhập mã xác nhận</label>
                <input type="text" class="form-control" id="Otp" name="Otp" placeholder="Nhập mã OTP gồm 6 chữ số" required />
                <small class="text-danger">@ViewBag.OtpError</small>
            </div>

            <div class="mb-3">
                <label for="NewPassword" class="form-label">Mật khẩu mới</label>
                <input type="password" class="form-control" id="NewPassword" name="NewPassword" placeholder="Nhập mật khẩu mới" required />
                <small class="text-danger">@ViewBag.PasswordError</small>
            </div>
        }

        <button type="submit" class="btn btn-dark w-100">
            @(ViewBag.ShowOtpInput == true ? "Xác nhận đổi mật khẩu" : "Gửi mã xác nhận")
        </button>

        <div class="text-center mt-3">
            <a href="/Account/Login" class="text-decoration-none">Quay lại đăng nhập</a>
        </div>
    </form>
</div>
