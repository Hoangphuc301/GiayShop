@{
    string emailValue = ViewBag.EmailValue ?? "";
    bool showOtp = ViewBag.ShowOtpInput != null && (bool)ViewBag.ShowOtpInput;
}

<div class="container mt-5" style="max-width: 500px;">
    <h2 class="text-center mb-4">Đăng ký tài khoản</h2>

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success text-center">@Html.Raw(ViewBag.Success)</div>
    }

    <form asp-action="FormRegister" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label>Email</label>
            <input name="Email" value="@emailValue" class="form-control" required />
            @if (ViewBag.EmailError != null)
            {
                <span class="text-danger">@ViewBag.EmailError</span>
            }
        </div>

        @if (!showOtp)
        {
            <div class="mb-3">
                <label>Mật khẩu</label>
                <input name="Matkhau" type="password" class="form-control" required />
                @if (ViewBag.PasswordError != null)
                {
                    <span class="text-danger">@ViewBag.PasswordError</span>
                }
            </div>

            <div class="mb-3">
                <label>Nhập lại mật khẩu</label>
                <input name="NhapLaiMatkhau" type="password" class="form-control" required />
                @if (ViewBag.ConfirmPasswordError != null)
                {
                    <span class="text-danger">@ViewBag.ConfirmPasswordError</span>
                }
            </div>
        }
        else
        {
            <div class="mb-3">
                <label>Nhập mã xác nhận (OTP)</label>
                <input name="Otp" class="form-control" maxlength="6" required />
                @if (ViewBag.OtpError != null)
                {
                    <span class="text-danger">@ViewBag.OtpError</span>
                }
            </div>
        }

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-success w-50 me-2">
                @(showOtp ? "Xác nhận OTP" : "Đăng ký")
            </button>
            <a asp-action="Login" asp-controller="Account" class="btn btn-outline-secondary w-50">
                Quay lại đăng nhập
            </a>
        </div>
    </form>
</div>
