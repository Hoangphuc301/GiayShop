@{
    string emailValue = ViewBag.EmailValue ?? "";
}

<div class="container mt-5" style="max-width: 500px;">
    <h2 class="text-center mb-4">Đăng ký tài khoản</h2>

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success text-center">@ViewBag.Success</div>
    }

    <form asp-action="FormRegister" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label>Email</label>
            <input name="Email" value="@emailValue" class="form-control" />
            @if (ViewBag.EmailError != null)
            {
                <span class="text-danger">@ViewBag.EmailError</span>
            }
        </div>

        <div class="mb-3">
            <label>Mật khẩu</label>
            <input name="Matkhau" type="password" class="form-control" />
            @if (ViewBag.PasswordError != null)
            {
                <span class="text-danger">@ViewBag.PasswordError</span>
            }
        </div>

        <div class="mb-3">
            <label>Nhập lại mật khẩu</label>
            <input name="NhapLaiMatkhau" type="password" class="form-control" />
            @if (ViewBag.ConfirmPasswordError != null)
            {
                <span class="text-danger">@ViewBag.ConfirmPasswordError</span>
            }
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-success w-50 me-2">Đăng ký</button>
            <a asp-action="Login" asp-controller="Account" class="btn btn-outline-secondary w-50">
                Quay lại đăng nhập
            </a>
        </div>
    </form>
</div>
