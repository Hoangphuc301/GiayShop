@{
    ViewData["Title"] = "Chính sách vận chuyển";
}

<!-- Nội dung chính sách -->
<div class="container mt-5 mb-5">
    <h2 class="text-center mb-4">Chính sách giao hàng</h2>
    <p class="lead text-center">StyleOfMe.vn giao hàng toàn quốc với chính sách minh bạch, nhanh chóng và tiết kiệm.</p>

    <div class="policy-content mt-4">
        <h5><strong>1. Phí vận chuyển</strong></h5>
        <p>StyleOfMe.vn miễn phí giao hàng toàn quốc cho đơn hàng có giá trị từ <strong>10.000.000đ</strong>.</p>
        <p>Đối với đơn hàng dưới 10.000.000đ, phí ship được áp dụng như sau:</p>
        <ul>
            <li><strong>Nội thành TP. Hồ Chí Minh:</strong> 50.000đ</li>
            <li><strong>Ngoại thành TP. Hồ Chí Minh:</strong> 100.000đ</li>
            <li><strong>Các tỉnh thành khác:</strong> 200.000đ</li>
        </ul>

        <h5 class="mt-4"><strong>2. Thời gian giao hàng</strong></h5>
        <ul>
            <li><strong>Khu vực nội thành TP. Hồ Chí Minh:</strong> 1 - 3 ngày làm việc</li>
            <li><strong>Khu vực ngoại thành và các thành phố trung tâm:</strong> 2 - 4 ngày làm việc</li>
            <li><strong>Các khu vực khác:</strong> 5 - 6 ngày làm việc</li>
        </ul>

        <h5 class="mt-4"><strong>3. Lưu ý</strong></h5>
        <p>Thời gian giao hàng có thể thay đổi do các yếu tố khách quan như thời tiết, lễ Tết hoặc sự cố vận chuyển. StyleOfMe.vn sẽ cố gắng hỗ trợ bạn nhanh nhất có thể.</p>
    </div>
</div>