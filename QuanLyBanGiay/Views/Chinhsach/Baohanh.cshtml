@{
    ViewData["Title"] = "Chính sách bảo hành";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="text-center mb-4">
                <h2 class="fw-bold">Chính sách bảo hành</h2>
                <p class="text-muted">
                    StyleOfMe.vn cam kết mang đến sản phẩm chính hãng cùng chính sách bảo hành minh bạch và uy tín.
                </p>
                <hr class="w-25 mx-auto">
            </div>

            <div class="card shadow-sm border-0 p-4">

                <h5 class="fw-bold text-primary mb-3">1. Thời gian bảo hành</h5>
                <p>
                    Tất cả sản phẩm được bảo hành trong vòng
                    <strong class="text-danger">30 ngày</strong> kể từ ngày mua hàng.
                </p>

                <h5 class="fw-bold text-primary mb-3 mt-4">2. Điều kiện bảo hành</h5>
                <ul class="list-group mb-4">
                    <li class="list-group-item">
                        Lỗi kỹ thuật phát sinh từ nhà sản xuất.
                    </li>
                    <li class="list-group-item">
                        Sản phẩm còn nguyên tem, không bị hư hại do sử dụng sai cách.
                    </li>
                    <li class="list-group-item">
                        Có hóa đơn mua hàng hợp lệ.
                    </li>
                </ul>

                <h5 class="fw-bold text-primary mb-3">3. Trường hợp không bảo hành</h5>
                <ul class="list-group mb-4">
                    <li class="list-group-item">
                        Hư hỏng do va đập, ngâm nước hoặc tác động vật lý.
                    </li>
                    <li class="list-group-item">
                        Hết thời hạn bảo hành.
                    </li>
                </ul>

                <h5 class="fw-bold text-primary mb-3">4. Hỗ trợ bảo hành</h5>
                <div class="alert alert-info mb-0">
                    📞 Hotline: <strong>0909 123 456</strong><br>
                    📧 Email: <strong>support@styleofme.vn</strong><br>
                    ⏰ Thời gian hỗ trợ: <strong>08:00 – 20:00</strong> (Thứ 2 – Chủ nhật)
                </div>

            </div>

        </div>
    </div>
</div>
