@{
    ViewData["Title"] = "Chính sách ưu đãi";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="text-center mb-4">
                <h2 class="fw-bold">Chính sách ưu đãi</h2>
                <p class="text-muted">
                    StyleOfMe.vn luôn mang đến những chương trình ưu đãi hấp dẫn dành cho khách hàng thân yêu.
                </p>
                <hr class="w-25 mx-auto">
            </div>

            <div class="card shadow-sm border-0 p-4">

                <ul class="list-group list-group-flush">

                    <li class="list-group-item py-3">
                        <h6 class="fw-bold mb-2 text-primary">Ưu đãi thành viên</h6>
                        <p class="mb-0">
                            Giảm ngay <strong class="text-danger">5%</strong> cho khách hàng
                            <strong>đăng ký tài khoản và mua hàng lần đầu</strong>.
                        </p>
                    </li>

                    <li class="list-group-item py-3">
                        <h6 class="fw-bold mb-2 text-primary">Ưu đãi sinh nhật</h6>
                        <p class="mb-0">
                            Tặng mã giảm giá <strong class="text-danger">10%</strong> cho khách hàng
                            trong <strong>tháng sinh nhật</strong>.
                        </p>
                    </li>

                    <li class="list-group-item py-3">
                        <h6 class="fw-bold mb-2 text-primary">Ưu đãi đơn hàng lớn</h6>
                        <p class="mb-0">
                            <strong class="text-success">Miễn phí vận chuyển toàn quốc</strong>
                            cho đơn hàng từ <strong>10.000.000₫</strong> trở lên.
                        </p>
                    </li>

                    <li class="list-group-item py-3">
                        <h6 class="fw-bold mb-2 text-primary">Ưu đãi mùa lễ</h6>
                        <p class="mb-0">
                            Giảm giá lên đến <strong class="text-danger">30%</strong>
                            cho các sản phẩm trong <strong>danh mục khuyến mãi</strong>.
                        </p>
                    </li>

                </ul>

                <div class="alert alert-warning mt-4 mb-0">
                    <strong>Lưu ý:</strong> Số lượng ưu đãi có hạn và có thể thay đổi theo từng thời điểm.
                    Vui lòng theo dõi website & fanpage để cập nhật chương trình mới nhất.
                </div>

            </div>

        </div>
    </div>
</div>
