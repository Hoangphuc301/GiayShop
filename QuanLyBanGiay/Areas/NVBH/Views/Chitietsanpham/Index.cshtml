@{
    Layout = null;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<div class="container mt-4">

    <h2 class="text-center mb-4 text-primary fw-bold">Danh mục chi tiết sản phẩm</h2>

    <div class="text-end mb-3">
        <a href="@Url.Action("them")" class="btn btn-success">
            ➕ Thêm mới
        </a>
    </div>

    <table class="table table-bordered table-hover text-center align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Tên sản phẩm</th>
                <th>Tên màu</th>
                <th>Số size</th>
                <th>Số lượng tồn</th>
                <th style="width:15%;">Tác vụ</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in ViewBag.Chitietsanpham)
            {
                <input type="hidden" name="Mactsp" value="@item.Mactsp" />
                <tr>
                    <td>@item.MaspNavigation.Tensp</td>
                    <td>@item.MamauNavigation.Tenmau</td>
                    <td>@item.MasizeNavigation.Tensize</td>
                    <td>@item.Slton</td>
                    <td>
                        <a href="@Url.Action("sua", "Chitietsanpham", new { area="NVBH", id=item.Mactsp })" class="btn btn-success btn-sm">✏️ Sửa</a>
                        <a href="@Url.Action("xoa", "Chitietsanpham", new { area="NVBH", id=item.Mactsp })" class="btn btn-danger btn-sm mt-1" onclick="return confirm('Bạn có chắc muốn xóa?')">🗑️ Xóa</a>
                    </td>
                </tr>
            }

        </tbody>
    </table>

    @{
        int trangHienTai = ViewBag.TrangHienTai ?? 1;
        int tongSoTrang = ViewBag.TongSoTrang ?? 0;
    }

    @if (tongSoTrang > 1)
    {
        <nav aria-label="Page navigation example" class="d-flex justify-content-center mt-4">
            <ul class="pagination shadow-sm">

                <li class="page-item @(trangHienTai == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { trang = trangHienTai - 1 })" aria-label="Previous">
                        <span aria-hidden="true">&lt;</span>
                    </a>
                </li>

                @{
                    int soTrangToiDaHienThi = 3;
                    int trangBatDau = Math.Max(1, trangHienTai - 1);
                    int trangKetThuc = Math.Min(tongSoTrang, trangBatDau + soTrangToiDaHienThi - 1);

                    if (trangHienTai > 1 && trangHienTai > tongSoTrang - soTrangToiDaHienThi + 1)
                    {
                        trangBatDau = Math.Max(1, tongSoTrang - soTrangToiDaHienThi + 1);
                        trangKetThuc = tongSoTrang;
                    }
                }

                @if (trangBatDau > 1)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { trang = 1 })">1</a></li>
                    @if (trangBatDau > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @for (int i = trangBatDau; i <= trangKetThuc; i++)
                {
                    <li class="page-item @(i == trangHienTai ? "active" : "")">
                        <a class="page-link @(i == trangHienTai ? "bg-dark border-dark text-white" : "")"
                           href="@Url.Action("Index", new { trang = i })">
                            @i
                        </a>
                    </li>
                }

                @if (trangKetThuc < tongSoTrang)
                {
                    @if (trangKetThuc < tongSoTrang - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { trang = tongSoTrang })">@tongSoTrang</a></li>
                }

                <li class="page-item @(trangHienTai == tongSoTrang ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { trang = trangHienTai + 1 })" aria-label="Next">
                        <span aria-hidden="true">&gt;</span>
                    </a>
                </li>

            </ul>
        </nav>
    }

    <div class="text-start mt-3">
        <a href="@Url.Content("~/NVBH")" class="btn btn-outline-secondary">
            ⬅️ Quay lại
        </a>
    </div>
</div>