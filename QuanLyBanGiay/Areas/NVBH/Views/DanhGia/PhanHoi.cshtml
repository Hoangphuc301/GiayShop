@model QuanLyBanGiay.Models.Danhgia

@{
    Layout = null; 
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<div class="container mt-5" style="max-width: 700px;">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Phản hồi đánh giá khách hàng</h4>
        </div>
        <div class="card-body">

            <div class="mb-4 p-3 bg-light rounded border">
                <p><strong>Khách hàng:</strong> @Model.Khachhang.Tenkh</p>
                <p><strong>Sản phẩm:</strong> @Model.Sanpham.Tensp</p>
                <p><strong>Đánh giá:</strong> <span class="text-warning fw-bold">@Model.Sao ★</span></p>
                <p><strong>Nội dung:</strong> "@Model.NoiDung"</p>
                <small class="text-muted">Ngày viết: @Model.NgayDanhGia.ToString("dd/MM/yyyy HH:mm")</small>
            </div>

            <form action="@Url.Action("LuuPhanHoi")" method="post">
                <input type="hidden" name="id" value="@Model.MaDanhGia" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Câu trả lời của Shop:</label>
                    <textarea name="noiDungPhanHoi" class="form-control" rows="5" placeholder="Nhập câu trả lời tại đây...">@Model.PhanHoi</textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy / Quay lại</a>
                    <button type="submit" class="btn btn-primary">Lưu Phản Hồi</button>
                </div>
            </form>

        </div>
    </div>
</div>