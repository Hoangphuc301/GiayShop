@model List<QuanLyBanGiay.Models.Danhgia>

@{
    Layout = null;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .btn-filter {
        background-color: #fff;
        border: 1px solid #e0e0e0;
        min-width: 90px;
        padding: 6px 12px;
        margin-right: 8px;
        margin-bottom: 8px;
        color: rgba(0,0,0,.8);
        text-decoration: none;
        display: inline-block;
        text-align: center;
        border-radius: 2px;
        font-size: 14px;
        transition: all 0.2s;
    }

        .btn-filter:hover {
            border-color: #ee4d2d;
            color: #ee4d2d;
        }

        .btn-filter.active {
            border-color: #ee4d2d;
            color: #ee4d2d;
            border-width: 1px;
        }

    .filter-section {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 5px;
    }
</style>

<div class="container mt-4">
    <h2 class="text-center mb-4 text-primary fw-bold">Quản lý đánh giá sản phẩm</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="filter-section p-3 mb-4">
        <form method="get" action="@Url.Action("Index")" id="filterForm">
            <div class="row g-3 align-items-end">

                <div class="col-md-5">
                    <div class="d-flex gap-2 align-items-center">
                        <div class="flex-grow-1">
                            <label class="form-label small fw-bold text-muted">Từ ngày:</label>
                            <input type="date" name="from" value="@ViewBag.FromDate" class="form-control form-control-sm">
                        </div>
                        <div class="flex-grow-1">
                            <label class="form-label small fw-bold text-muted">Đến ngày:</label>
                            <input type="date" name="to" value="@ViewBag.ToDate" class="form-control form-control-sm">
                        </div>
                        <div>
                            <label class="form-label d-block">&nbsp;</label>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-funnel"></i> Lọc ngày
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-7">
                    <label class="form-label small fw-bold text-muted d-block">Lọc theo đánh giá:</label>

                    @{
                        var fromVal = ViewBag.FromDate;
                        var toVal = ViewBag.ToDate;
                        int? current = ViewBag.CurrentSao as int?;
                    }

                    <a href="@Url.Action("Index", new { sao = (int?)null, from = fromVal, to = toVal })"
                       class="btn-filter @(current == null ? "active" : "")">
                        Tất Cả (@ViewBag.CountAll)
                    </a>

                    <a href="@Url.Action("Index", new { sao = 5, from = fromVal, to = toVal })"
                       class="btn-filter @(current == 5 ? "active" : "")">
                        5 Sao (@ViewBag.Count5)
                    </a>

                    <a href="@Url.Action("Index", new { sao = 4, from = fromVal, to = toVal })"
                       class="btn-filter @(current == 4 ? "active" : "")">
                        4 Sao (@ViewBag.Count4)
                    </a>

                    <a href="@Url.Action("Index", new { sao = 3, from = fromVal, to = toVal })"
                       class="btn-filter @(current == 3 ? "active" : "")">
                        3 Sao (@ViewBag.Count3)
                    </a>

                    <a href="@Url.Action("Index", new { sao = 2, from = fromVal, to = toVal })"
                       class="btn-filter @(current == 2 ? "active" : "")">
                        2 Sao (@ViewBag.Count2)
                    </a>

                    <a href="@Url.Action("Index", new { sao = 1, from = fromVal, to = toVal })"
                       class="btn-filter @(current == 1 ? "active" : "")">
                        1 Sao (@ViewBag.Count1)
                    </a>
                </div>
            </div>

        </form>

        <div class="mt-2 text-end border-top pt-2">
            <a href="@Url.Action("Index")" class="text-decoration-none text-secondary small">
                <i class="bi bi-arrow-counterclockwise"></i> Đặt lại bộ lọc
            </a>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark text-center">
                <tr>
                    <th width="140">Khách hàng</th>
                    <th>Sản phẩm</th>
                    <th width="110">Đánh giá</th>
                    <th width="20%">Nội dung khách</th>
                    <th width="25%">Phản hồi của Shop</th>
                    <th width="110">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var dg in Model)
                    {
                        <tr>
                            <td class="fw-bold">@dg.Khachhang.Tenkh</td>
                            <td class="text-primary fw-semibold">@dg.Sanpham.Tensp</td>
                            <td class="text-center text-warning">
                                @dg.Sao <i class="bi bi-star-fill"></i>
                            </td>
                            <td>
                                <p class="mb-0">@dg.NoiDung</p>
                                <small class="text-muted">@dg.NgayDanhGia.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td class="bg-light">
                                @if (!string.IsNullOrEmpty(dg.PhanHoi))
                                {
                                    <div class="p-2 bg-white rounded border border-success border-start-0 border-end-0 border-top-0 border-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="badge bg-success" style="font-size: 0.7rem;">Đã trả lời</span>
                                            <small class="text-muted" style="font-size: 0.7rem;">@dg.NgayPhanHoi?.ToString("dd/MM HH:mm")</small>
                                        </div>
                                        <p class="mb-0 text-success fst-italic small">"@dg.PhanHoi"</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center"><span class="badge bg-secondary opacity-50">Chưa phản hồi</span></div>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="@Url.Action("PhanHoi", new { id = dg.MaDanhGia })" class="btn btn-outline-primary btn-sm" title="Trả lời"><i class="bi bi-reply-fill"></i></a>
                                    <form action="@Url.Action("Xoa")" method="post" onsubmit="return confirm('Xóa đánh giá này?')">
                                        <input type="hidden" name="id" value="@dg.MaDanhGia" />
                                        <button class="btn btn-outline-danger btn-sm" title="Xóa"><i class="bi bi-trash-fill"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x display-6 d-block mb-3"></i>
                            Không tìm thấy đánh giá nào trong khoảng thời gian hoặc số sao này.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="text-start mt-3">
        <a href="@Url.Content("~/Admin")" class="btn btn-outline-secondary">
            ⬅️ Quay lại
        </a>
    </div>
</div>