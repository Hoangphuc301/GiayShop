@{
    Layout = null;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" /> 

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary fw-bold">ĐƠN HÀNG CỦA TÔI</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <strong>Thu hộ COD:</strong> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover table-bordered text-center align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Mã đơn</th>
                    <th>Tên khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Phương thức</th>
                    <th>Trạng thái</th>
                    <th style="width: 25%;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.Donhang != null && ((IEnumerable<dynamic>)ViewBag.Donhang).Any())
                {
                    foreach (var item in ViewBag.Donhang)
                    {
                        <tr>
                            <td><strong>@item.Madh</strong></td>
                            <td>@item.MakhNavigation?.Tenkh</td>
                            <td>@item.Ngaydat?.ToString("dd/MM HH:mm")</td>
                            <td class="text-danger fw-bold">@item.Tongtiencuoi?.ToString("N0") ₫</td>
                            <td>@item.MaptttNavigation?.Tenphuongthuc</td>
                            <td>@item.Trangthai</td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="@Url.Action("XemChiTiet", new { id = item.Madh })"
                                       class="btn btn-sm btn-outline-primary">
                                        Xem chi tiết
                                    </a>

                                    <form method="post" action="@Url.Action("XacNhanGiaoThanhCong")" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Madh" value="@item.Madh" />
                                        <button type="submit"
                                                class="btn btn-sm btn-success" 
                                                onclick="return confirm('Xác nhận đã giao thành công đơn @item.Madh?\n@(item.MaptttNavigation?.Tenphuongthuc.Contains("COD", StringComparison.OrdinalIgnoreCase) == true ? "Thu hộ: " + item.Tongtiencuoi?.ToString("N0") + " ₫" : "")')">
                                            Xác nhận giao hàng
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-muted py-5">
                            <h5>Chưa có đơn hàng nào đang giao</h5>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @{
        int trangHienTai = ViewBag.TrangHienTai;
        int tongSoTrang = ViewBag.TongSoTrang;
    }

    @if (tongSoTrang > 1)
    {
        <nav aria-label="pagination" class="d-flex justify-content-center mt-4">
            <ul class="pagination shadow-sm">
                <li class="page-item @(trangHienTai == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { trang = trangHienTai - 1 })" aria-label="Truoc">
                        <span aria-hidden="true">&lt;</span>
                    </a>
                </li>
                @{
                    int soTrangToiDaHienThi = 3;
                    int trangBatDau = Math.Max(1, trangHienTai - 1);
                    int trangKetThuc = Math.Min(tongSoTrang, trangBatDau + soTrangToiDaHienThi - 1);

                    if (trangHienTai > 1 && trangHienTai > tongSoTrang - soTrangToiDaHienThi + 1)
                    {
                        trangBatDau = Math.Max(1, tongSoTrang - soTrangToiDaHienThi + 1);
                        trangKetThuc = tongSoTrang;
                    }
                }
                @if (trangBatDau > 1)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { trang = 1 })">1</a></li>
                    @if (trangBatDau > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }
                @for (int i = trangBatDau; i <= trangKetThuc; i++)
                {
                    <li class="page-item @(i == trangHienTai ? "active" : "")">
                        <a class="page-link @(i == trangHienTai ? "bg-dark border-dark text-white" : "")"
                           href="@Url.Action("Index", new { trang = i })">
                            @i
                        </a>
                    </li>
                }
                @if (trangKetThuc < tongSoTrang)
                {
                    @if (trangKetThuc < tongSoTrang - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { trang = tongSoTrang })">@tongSoTrang</a>
                    </li>
                }
                <li class="page-item @(trangHienTai == tongSoTrang ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { trang = trangHienTai + 1 })" aria-label="Next">
                        <span aria-hidden="true">&gt;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }

    <div class="text-start mt-3">
        <a href="@Url.Content("~/NVGH")" class="btn btn-outline-secondary">
            ⬅️ Quay lại
        </a>
    </div>
</div>