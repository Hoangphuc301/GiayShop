@{
    Layout = null;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary fw-bold">ĐƠN HÀNG CỦA TÔI</h2>

    <!-- Thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-warning">@TempData["InfoMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <!-- Tab lọc đơn -->
    <div class="d-flex justify-content-center mb-4 gap-3">
        <a href="@Url.Action("Index", new { loai = "dang-giao" })"
           class="btn @(ViewBag.Loai == "dang-giao" ? "btn-primary" : "btn-outline-primary")">
            Đơn đang giao
        </a>

        <a href="@Url.Action("Index", new { loai = "da-giao-huy" })"
           class="btn @(ViewBag.Loai == "da-giao-huy" ? "btn-primary" : "btn-outline-primary")">
            Đơn đã giao & Hủy
        </a>
    </div>

    <!-- Bảng đơn hàng -->
    <div class="table-responsive">
        <table class="table table-bordered text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th>Chi tiết</th>
                    <th>Tác vụ</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in ViewBag.Donhang)
                {
                    // LOGIC HIỂN THỊ THANH TOÁN
                    string thanhtoan = "Đã thanh toán"; // mặc định theo yêu cầu

                    <tr>
                        <td><strong>@item.Madh</strong></td>
                        <td>@item.MakhNavigation?.Tenkh</td>
                        <td>@item.Ngaydat?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-danger fw-bold">@item.Tongtiencuoi.ToString("N0") ₫</td>

                        <td class="fw-bold text-success">Đã thanh toán</td>

                        <td>@item.Trangthai</td>

                        <td>
                            <a href="@Url.Action("XemChiTiet", new { id = item.Madh })"
                               class="btn btn-sm btn-outline-primary">Xem</a>
                        </td>

                        <td>
                            <div class="d-flex justify-content-center gap-2">

                                @* Nút xác nhận giao thành công *@
                                @if (item.Trangthai == "ĐANG GIAO")
                                {
                                    <form method="post" action="@Url.Action("XacNhanGiaoThanhCong")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Madh" value="@item.Madh" />
                                        <button class="btn btn-success btn-sm">
                                            Giao thành công
                                        </button>
                                    </form>
                                }

                                @* Nút nộp COD *@
                                @if (item.Trangthai == "ĐÃ NHẬN"
                               && item.MaptttNavigation.Tenphuongthuc.Contains("COD")
                               && item.DaNopTienCOD == false)
                                {
                                    <form method="post" action="@Url.Action("XacNhanNopTienCOD")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Madh" value="@item.Madh" />
                                        <button class="btn btn-warning btn-sm">
                                            Nộp COD
                                        </button>
                                    </form>
                                }

                                @* Đơn hủy *@
                                @if (item.Trangthai == "HỦY")
                                {
                                    <button class="btn btn-danger btn-sm" disabled>Đã hủy</button>
                                }

                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>

    <a href="@Url.Content("~/NVGH")" class="btn btn-outline-secondary mt-3">⬅ Quay lại</a>
</div>
