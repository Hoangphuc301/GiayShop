@model QuanLyBanGiay.Models.Voucher

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4" style="max-width:700px;">
    <h2 class="text-danger fw-bold mb-4">Xóa Voucher</h2>

    <div class="card p-4 shadow-sm bg-light">
        <dl class="row mb-0">
            <dt class="col-sm-4">Mã Voucher:</dt>
            <dd class="col-sm-8">@Model.Mavoucher</dd>

            <dt class="col-sm-4">Tên Voucher:</dt>
            <dd class="col-sm-8">@Model.Tenvoucher</dd>

            <dt class="col-sm-4">Mã giảm giá:</dt>
            <dd class="col-sm-8">@Model.Magiamgia</dd>

            <dt class="col-sm-4">Giá trị (%):</dt>
            <dd class="col-sm-8">@Model.Giatri</dd>

            <dt class="col-sm-4">Ngày bắt đầu:</dt>
            <dd class="col-sm-8">@Model.Ngaybd?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Ngày kết thúc:</dt>
            <dd class="col-sm-8">@Model.Ngaykt?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Trạng thái:</dt>
            <dd class="col-sm-8">@Model.Trangthai</dd>
        </dl>
    </div>

    <form asp-area="Admin" asp-controller="Voucher" asp-action="xoa" method="post" class="mt-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Mavoucher" value="@Model.Mavoucher" />

        <p class="fs-5 text-center text-danger fw-semibold">
            Bạn có chắc chắn muốn xóa Voucher
            <strong>@Model.Tenvoucher</strong> (Mã: <strong>@Model.Magiamgia</strong>) không?
        </p>

        <div class="row">
            <div class="col-6">
                <a href="@Url.Action("Index","Voucher", new { area="Admin"})"
                   class="btn btn-outline-secondary w-100">⬅️ Quay lại</a>
            </div>
            <div class="col-6">
                <button type="submit" class="btn btn-danger w-100">🗑️ Xác nhận xóa</button>
            </div>
        </div>
    </form>
</div>
