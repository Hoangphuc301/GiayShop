@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<div class="container mt-4">

    <h2 class="text-center mb-4 text-primary fw-bold">Danh Mục Voucher Giảm Giá</h2>

    <div class="text-end mb-3">
        <a href="@Url.Action("them", "Voucher", new { area = "Admin" })" class="btn btn-success">
            ➕ Thêm mới
        </a>
    </div>

    <table class="table table-bordered table-hover text-center align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Mã Voucher</th>
                <th>Tên Voucher</th>
                <th>Mã Giảm Giá</th>
                <th>Giá Trị (%)</th>
                <th>Ngày Bắt Đầu</th>
                <th>Ngày Kết Thúc</th>
                <th>Trạng Thái</th>
                <th style="width:15%;">Tác vụ</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.Vouchers != null)
            {
                foreach (var item in ViewBag.Vouchers)
                {
                    <tr>
                        <td>@item.Mavoucher</td>
                        <td>@item.Tenvoucher</td>
                        <td>@item.Magiamgia</td>
                        <td>@item.Giatri</td>
                        <td>@item.Ngaybd?.ToString("dd/MM/yyyy")</td>
                        <td>@item.Ngaykt?.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.Trangthai == "CÒN")
                            {
                                <span class="badge bg-success">Còn hiệu lực</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Hết hạn</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("sua", "Voucher", new { area="Admin", id=item.Mavoucher })" class="btn btn-success btn-sm">
                                ✏️ Sửa
                            </a>
                            <a href="@Url.Action("xoa", "Voucher", new { area="Admin", id=item.Mavoucher })"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Bạn có chắc muốn xóa voucher này không?')">
                                🗑️ Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">Không có voucher nào trong hệ thống.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-start mt-3">
        <a href="@Url.Content("~/Admin")" class="btn btn-outline-secondary">
            ⬅️ Quay lại
        </a>
    </div>
</div>
