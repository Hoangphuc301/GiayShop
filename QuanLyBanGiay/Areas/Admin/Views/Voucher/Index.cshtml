@model IEnumerable<QuanLyBanGiay.Models.Voucher>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold mb-0">🎫 Quản Lý Mã Khuyến Mãi</h2>
        <a href="@Url.Action("them", "Voucher", new { area = "Admin" })" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle"></i> ➕ Thêm Voucher Mới
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark text-center">
                    <tr>
                        <th>ID</th>
                        <th class="text-start">Tên & Mã Code</th>
                        <th>Loại KM</th>
                        <th>Giá Trị</th>
                        <th>Thời Gian</th>
                        <th>Lượt Dùng</th>
                        <th>Trạng Thái</th>
                        <th style="width: 150px;">Tác vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                                    <tr>
                                        <td class="text-center fw-bold text-secondary">#@item.Mavoucher</td>

                                        <td>
                                            <div class="fw-bold text-primary">@item.Tenvoucher</div>
                                            <div class="badge bg-light text-dark border mt-1">
                                                CODE: <span class="fw-bold text-danger">@item.Magiamgia</span>
                                            </div>
                                        </td>

                                        <td class="text-center">
                                    @if (item.LoaiKhuyenMai == 1)
                                    {
                                                    <span class="badge bg-info text-dark">Theo %</span>
                                    }
                                    else if (item.LoaiKhuyenMai == 2)
                                    {
                                                    <span class="badge bg-warning text-dark">Tiền mặt</span>
                                    }
                                    else
                                    {
                                                    <span class="badge bg-success">FreeShip</span>
                                    }
                                        </td>

                                        <td class="text-center fw-bold">
                                    @if (item.LoaiKhuyenMai == 1)
                                    {
                                                    <span class="text-danger">-@(item.Giatri?.ToString("0.##"))%</span>
                                    }
                                    else if (item.LoaiKhuyenMai == 2)
                                    {
                                                    <span class="text-success">-@string.Format("{0:N0}đ", item.Giatri)</span>
                                    }
                                    else
                                    {
                                                    <span>0đ (Ship)</span>
                                    }
                                        </td>

                                        <td class="small text-center">
                                            <div>@item.Ngaybd?.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted">⬇</div>
                                            <div>@item.Ngaykt?.ToString("dd/MM/yyyy")</div>
                                        </td>

                                        <td class="text-center">
                                            <span class="badge bg-secondary">
                                        @item.DaSuDung / @(item.GioiHanSuDung.HasValue ? item.GioiHanSuDung.ToString() : "∞")
                                            </span>
                                        </td>

                                        <td class="text-center">
                                    @if (item.Trangthai == "CÒN" && item.Ngaykt >= DateTime.Now)
                                    {
                                                    <span class="badge bg-success">Đang chạy</span>
                                    }
                                    else
                                    {
                                                    <span class="badge bg-danger">Hết hạn/Dừng</span>
                                    }
                                        </td>

                                        <td class="text-center">
                                            <a href="@Url.Action("sua", "Voucher", new { area="Admin", id=item.Mavoucher })" 
                                               class="btn btn-sm btn-outline-primary" title="Sửa">
                                                ✏️
                                            </a>
                                            <a href="@Url.Action("xoa", "Voucher", new { area="Admin", id=item.Mavoucher })" 
                                               class="btn btn-sm btn-outline-danger" title="Xóa"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa voucher [@item.Magiamgia] này không?');">
                                                🗑️
                                            </a>
                                        </td>
                                    </tr>
                        }
                    }
                    else
                    {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Chưa có mã khuyến mãi nào. Hãy tạo mới!
                                </td>
                            </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>