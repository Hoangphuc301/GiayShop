            case "metallic vàng": return "#D4AF37";
            case "xanh ngọc lam": return "#48D1CC";
            case "đồng": return "#CD7F32";
            case "rose gold": return "#B76E79";
            case "gunmetal": return "#2A3439";
            case "metallic": return "#B0C4DE";
            case "smoke": return "#738678";
            case "sand": return "#C2B280";
            case "off white": return "#FAF9F6";
            case "indigo": return "#4B0082";
            case "xanh chàm": return "#4B0082";

            default: return "transparent";
        }
    }
}
