@model QuanLyBanGiay.Models.Donhang

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<div class="container mt-4" style="max-width: 700px;">
    <h2 class="text-center mb-4 text-primary fw-bold">✏️ Cập nhật Trạng Thái Đơn Hàng</h2>

@*     @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    } *@

    <form asp-area="Admin" asp-controller="Donhang" asp-action="Sua" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Madh" />

        <div class="mb-3">
            <label class="form-label fw-semibold">Tên khách hàng</label>
            <input type="text" class="form-control" value="@Model.MakhNavigation.Tenkh" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Trạng thái</label>
            <select asp-for="Trangthai" class="form-select" id="trangthai">
                <option value="CHỜ XÁC NHẬN" @(Model.Trangthai == "CHỜ XÁC NHẬN" ? "selected" : "")>CHỜ XÁC NHẬN</option>
                <option value="ĐANG GIAO" @(Model.Trangthai == "ĐANG GIAO" ? "selected" : "")>ĐANG GIAO</option>
                <option value="ĐÃ NHẬN" @(Model.Trangthai == "ĐÃ NHẬN" ? "selected" : "")>ĐÃ NHẬN</option>
                <option value="HỦY" @(Model.Trangthai == "HỦY" ? "selected" : "")>HỦY</option>
            </select>
        </div>

        <div class="mb-3" id="lydoHuyGroup" style="display:@(Model.Trangthai == "HỦY" ? "block" : "none")">
            <label class="form-label fw-semibold">Lý do hủy</label>
            <input asp-for="Lydohuy" class="form-control" placeholder="Nhập lý do hủy nếu có..." />
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-success px-4">💾 Lưu thay đổi</button>
            <a asp-area="Admin" asp-controller="Donhang" asp-action="Index" class="btn btn-secondary px-3">↩️ Quay lại</a>
        </div>
    </form>
</div>

<script>
    document.getElementById("trangthai").addEventListener("change", function () {
        document.getElementById("lydoHuyGroup").style.display = this.value === "HỦY" ? "block" : "none";
    });
</script>
