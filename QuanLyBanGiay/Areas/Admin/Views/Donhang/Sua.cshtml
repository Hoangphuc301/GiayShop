@model QuanLyBanGiay.Models.Donhang

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var dh = ViewBag.Donhang;
}

@if (dh != null)
{
    <div class="container mt-4" style="max-width: 700px;">
        <h2 class="mb-3 text-primary fw-bold">📝 Cập nhật trạng thái đơn hàng</h2>

        <form asp-area="Admin" asp-controller="Donhang" asp-action="Sua" method="post" class="card p-4 shadow-sm">
            @Html.AntiForgeryToken()

            <input type="hidden" name="Madh" value="@dh.Madh" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Tên khách hàng</label>
                <input type="text" class="form-control" value="@dh.MakhNavigation.Tenkh" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Trạng thái</label>
                <select name="Trangthai" class="form-select" id="trangthai">
                    <option value="CHỜ XÁC NHẬN" @(dh.Trangthai == "CHỜ XÁC NHẬN" ? "selected" : "")>CHỜ XÁC NHẬN</option>
                    <option value="ĐANG GIAO" @(dh.Trangthai == "ĐANG GIAO" ? "selected" : "")>ĐANG GIAO</option>
                    <option value="ĐÃ NHẬN" @(dh.Trangthai == "ĐÃ NHẬN" ? "selected" : "")>ĐÃ NHẬN</option>
                    <option value="HỦY" @(dh.Trangthai == "HỦY" ? "selected" : "")>HỦY</option>
                </select>
            </div>

            <div class="mb-3" id="lydoHuyGroup" style="display:@(dh.Trangthai == "HỦY" ? "block" : "none")">
                <label class="form-label fw-semibold">Lý do hủy</label>
                <input name="Lydohuy" value="@dh.Lydohuy" class="form-control" placeholder="Nhập lý do hủy nếu có..." />
            </div>

            <div class="row mt-3">
                <div class="col-6">
                    <a href="@Url.Action("Index","Donhang", new { area="Admin"})" class="btn btn-outline-secondary w-100">⬅️ Quay lại</a>
                </div>
                <div class="col-6">
                    <button type="submit" class="btn btn-primary w-100">💾 Lưu thay đổi</button>
                </div>
            </div>
        </form>
    </div>
}
else
{
    <p>Không tìm thấy đơn hàng này. Vui lòng thử lại.</p>
    <a href="@Url.Action("Index","Donhang", new { area="Admin"})" class="btn btn-secondary">⬅️ Quay lại danh sách</a>
}


<script>
    document.getElementById("trangthai").addEventListener("change", function () {
        document.getElementById("lydoHuyGroup").style.display = this.value === "HỦY" ? "block" : "none";
    });
</script>