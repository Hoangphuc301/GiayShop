@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<div class="container mt-4">
    <h2 class="text-center mb-4 text-primary fw-bold">Danh Sách Đơn Hàng</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center fw-semibold">
            @TempData["Success"]
        </div>
    }

    <table class="table table-bordered table-hover text-center align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Mã đơn</th>
                <th>Tên khách hàng</th>
                <th>Ngày đặt</th>
                <th>Phương thức TT</th>
                <th>Voucher</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th style="width:18%;">Tác vụ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Madh</td>
                    <td>@item.MakhNavigation.Tenkh</td>
                    <td>@item.Ngaydat?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.MaptttNavigation.Tenphuongthuc</td>
                    <td>
                        @(item.MavoucherNavigation != null
                            ? item.MavoucherNavigation.Tenvoucher
                            : "-")
                    </td>
                    <td>@item.Tongtiencuoi?.ToString("N0") ₫</td>
                    <td>
                        <span class="badge bg-@(item.Trangthai switch {
                            "CHỜ XÁC NHẬN" => "warning",
                            "ĐANG GIAO" => "info",
                            "ĐÃ NHẬN" => "success",
                            "HỦY" => "danger",
                            _ => "secondary"
                        }) px-2 py-1">@item.Trangthai</span>
                    </td>
                    <td>
                        <a href="@Url.Action("Sua", "Donhang", new { area="Admin", id=item.Madh })"
                           class="btn btn-success btn-sm">✏️ Sửa</a>
                        <a href="@Url.Action("XemChiTiet", "Donhang", new { area="Admin", id=item.Madh })"
                           class="btn btn-primary btn-sm">🔍 Chi tiết</a>
                        <a href="@Url.Action("Xoa", "Donhang", new { area="Admin", id=item.Madh })"
                           class="btn btn-danger btn-sm"> Xóa</a>
                       </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-start mt-3">
        <a href="@Url.Content("~/Admin")" class="btn btn-outline-secondary">
            ⬅️ Quay lại
        </a>
    </div>
</div>
