@model QuanLyBanGiay.Models.Donhang

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Hủy Đơn Hàng";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4 text-danger fw-bold">Xác nhận hủy đơn hàng</h2>
    <div class="card p-4 shadow-sm border-danger">
        <p class="lead">Bạn có chắc chắn muốn hủy đơn hàng @Model.Madh của khách hàng @Model.MakhNavigation.Tenkh?</p>
        <p class="text-danger fw-bold">Hành động này sẽ thay đổi trạng thái thành HỦY và không thể hoàn tác.</p>

        <form asp-area="Admin" asp-controller="Donhang" asp-action="Huy" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="Madh" value="@Model.Madh" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Lý do hủy (Bắt buộc)</label>
                <textarea name="Lydohuy" class="form-control" rows="3" required placeholder="Vui lòng nhập lý do hủy đơn hàng..."></textarea>
            </div>

            <div class="row mt-4">
                <div class="col-6">
                    <a href="@Url.Action("Index","Donhang", new { area="Admin"})" class="btn btn-secondary">⬅️ Quay lại danh sách</a>
                </div>
                <div class="col-6">
                    <button type="submit" class="btn btn-danger w-100">Hủy đơn hàng</button>
                </div>
            </div>
        </form>
    </div>
</div>